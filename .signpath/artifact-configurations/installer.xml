<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration "installer": the Inno Setup installer, uploaded by .github/workflows/release.yml as a
     GitHub artifact (a zip with the setup.exe at its root). Paste it into the SignPath project with the slug "installer". -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file-set product-name="MediaRenamer" product-version="${version}">
      <include path="MediaRenamer-*-setup.exe" />
      <for-each>
        <authenticode-sign />
      </for-each>
    </pe-file-set>
  </zip-file>
</artifact-configuration>
