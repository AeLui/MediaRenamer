<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration "app": the two jpackage launchers, uploaded by .github/workflows/release.yml as a
     GitHub artifact (a zip with both files at its root). Paste it into the SignPath project with the slug "app". -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file-set product-version="${version}">
      <include path="MediaRenamer.exe" product-name="MediaRenamer" />
      <include path="MediaRenamer-cli.exe" product-name="MediaRenamer-cli" />
      <for-each>
        <authenticode-sign />
      </for-each>
    </pe-file-set>
  </zip-file>
</artifact-configuration>
